#!/usr/bin/env python3
"""
UDP Stress Tester - FOR AUTHORIZED USE ONLY
Measures how a server handles high-rate UDP traffic.
"""

import socket
import random
import time
import threading
import argparse
from colorama import init, Fore

init(autoreset=True)

def send_udp(target_ip, target_port, duration, packet_size=1024):
    """Send UDP packets to target until duration expires."""
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        data = random._urandom(packet_size)
        end_time = time.time() + duration
        packet_count = 0
        while time.time() < end_time:
            sock.sendto(data, (target_ip, target_port))
            packet_count += 1
        sock.close()
        return packet_count
    except Exception as e:
        print(Fore.RED + f"Thread error: {e}")
        return 0

def main():
    parser = argparse.ArgumentParser(description="UDP Stress Test (Authorized Use Only)")
    parser.add_argument("target_ip", help="Target IP address")
    parser.add_argument("target_port", type=int, help="Target UDP port")
    parser.add_argument("--threads", type=int, default=10, help="Number of threads (default: 10)")
    parser.add_argument("--duration", type=int, default=10, help="Test duration in seconds (default: 10)")
    parser.add_argument("--packet-size", type=int, default=1024, help="Packet size in bytes (default: 1024)")
    args = parser.parse_args()

    print(Fore.YELLOW + "⚠️  LEGAL NOTICE: You must own or have written permission to test the target.")
    confirm = input("Do you confirm? (yes/no): ")
    if confirm.lower() != "yes":
        print("Aborted.")
        return

    print(Fore.GREEN + f"Starting UDP test on {args.target_ip}:{args.target_port} with {args.threads} threads for {args.duration}s")
    threads = []
    start_time = time.time()

    for _ in range(args.threads):
        t = threading.Thread(target=send_udp, args=(args.target_ip, args.target_port, args.duration, args.packet_size))
        t.start()
        threads.append(t)

    for t in threads:
        t.join()

    print(Fore.GREEN + f"Test completed in {time.time() - start_time:.2f} seconds.")

if __name__ == "__main__":
    main()
